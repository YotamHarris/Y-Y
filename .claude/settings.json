{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/studio/fe_sync.py\" session-start",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/studio/fe_board.py\" open --no-browser --quiet",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/studio/fe_sync.py\" prompt",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/studio/fe_sync.py\" pre-bash",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/studio/fe_board.py\" hook-post"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/studio/fe_board.py\" hook-end"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/studio/fe_sync.py\" stop",
            "timeout": 900
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/studio/fe_board.py\" hook-stop"
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/studio/fe_jev.py\" hook-stop"
          }
        ]
      }
    ]
  }
}
