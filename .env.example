# Copy to .env. Never paste tokens into Discord or commit them.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_USER_IDS=YOUR_USER_ID,FRIEND_USER_ID
GITHUB_TOKEN=
GITHUB_REPOSITORY=YotamHarris/Y-Y
YY_DEFAULT_PROVIDER=codex
YY_CODEX_AUTH=subscription
YY_CLAUDE_AUTH=subscription
# Native executable paths override PATH lookup, especially for Windows service accounts.
YY_CODEX_PATH=codex
YY_CLAUDE_PATH=claude
# Optional, for API mode only:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# YY_REPO_ROOT=D:\Source\Y&Y\YYEngine
# YY_DATA_DIR=D:\YYAgentData
# YY_AGENT_TIMEOUT_MS=1800000
# Optional: plain-language planning in this Discord project channel. When omitted,
# the single channel used by existing tasks is reused automatically.
# YY_DISCORD_CHANNEL_ID=
# Optional: read-only questions in a separate channel (meatbag-talk is discovered by name).
# YY_DISCORD_TALK_CHANNEL_ID=
